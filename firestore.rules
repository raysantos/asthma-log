rules_version = '2';

// Anyone can view the log. Only the shared family account (unlocked with the
// family password in the app) can add, change or delete anything.
// Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function family() {
      return request.auth != null
        && request.auth.token.email == 'asthma-log-family@example.com';
    }

    match /config/meds {
      allow read: if true;
      allow write: if family() && request.resource.data.items is list;
    }

    match /doses/{doseId} {
      allow read: if true;
      allow delete: if family();
      allow create, update: if family()
        && request.resource.data.at is number
        && request.resource.data.name is string
        && request.resource.data.keys().hasOnly(['medId', 'name', 'kind', 'dose', 'note', 'at', 'loggedAt']);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
